# ==============================================================================
# GrantSupport Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and replace all placeholder values before deployment.
# NEVER commit production .env files containing real secret keys to Git.

# --- Runtime & Server Environment ---
GO_ENV=development
PORT=8080
HTTPS_PORT=8443
TLS_ENABLED=false
# TLS_CERT_FILE=/etc/ssl/certs/server.crt
# TLS_KEY_FILE=/etc/ssl/private/server.key
HTTP_TO_HTTPS_REDIRECT=false
HSTS_ENABLED=false
# HSTS_MAX_AGE=31536000
# HSTS_INCLUDE_SUBDOMAINS=false
# HSTS_PRELOAD=false

# --- Trusted Proxies (Comma-separated CIDR list) ---
# Default is loopback only ("127.0.0.1,::1"). Configure your upstream ALB / Cloudflare CIDRs here:
TRUSTED_PROXIES=127.0.0.1,::1

# --- Database Configuration ---
# Dialect: postgres | mysql | mariadb | sqlite
DATABASE_DIALECT=postgres
DATABASE_URL=postgresql://grantsupport:YOUR_SECURE_PASSWORD@localhost:5432/grantsupport?sslmode=verify-full
AUTO_MIGRATE=false
DB_MAX_OPEN_CONNS=50
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_MINUTES=15
DB_CONN_MAX_IDLE_TIME_MINUTES=5

# --- Optional Distributed Cache & Lock Store (Valkey / Redis) ---
VALKEY_CACHE_URL=valkey://127.0.0.1:6379/0

# --- Webhook Dispatcher ---
# WEBHOOK_URL=https://customer-api.example.com/webhooks/grantsupport
# WEBHOOK_SECRET=generate_a_random_32_byte_hex_string_here

# --- Asymmetric RS256 JWT Keys (Required in Production) ---
# Generate using:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
# Then assign the PEM string or base64-encoded content:
JWT_PRIVATE_KEY=""
JWT_PUBLIC_KEY=""
